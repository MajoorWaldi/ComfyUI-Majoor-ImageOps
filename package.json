{
  "name": "comfyui-majoor-imageops",
  "version": "0.1.5",
  "description": "WORK IN PROGRESS",
  "scripts": {
    "generate:metadata": "node scripts/generate-imageops-metadata.mjs",
    "check:metadata": "node scripts/generate-imageops-metadata.mjs --check",
    "build": "npm run generate:metadata && node esbuild.mjs",
    "check": "npm run check:metadata && tsc --noEmit",
    "dev": "node esbuild.mjs --watch",
    "test:py": "python -m pytest tests/unit -v",
    "test:js": "node --test tests/frontend/*.test.cjs",
    "test:ts": "tsc --noEmit -p tsconfig.frontend-tests.json",
    "test": "npm run test:py && npm run test:js && npm run test:ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MajoorWaldi/ComfyUI-Majoor-ImageOps.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MajoorWaldi/ComfyUI-Majoor-ImageOps/issues"
  },
  "homepage": "https://github.com/MajoorWaldi/ComfyUI-Majoor-ImageOps#readme",
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  }
}
